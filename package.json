{
  "name": "learn-node",
  "version": "1.0.0",
  "private": true,
  "description": "Notes CRUD API - Express, TypeScript aur pure SQL par Postgres. Learning project.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node --env-file=.env dist/server.js",
    "migrate": "tsc && node --env-file=.env dist/db/migrate.js",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "express",
    "postgres",
    "crud",
    "learning"
  ],
  "author": "TheAbdulRehman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAbdulRehman/learn-node.git"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0"
  }
}
