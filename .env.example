# Is file ko copy kar ke .env banayein aur asli values daalein:
#   cp .env.example .env
#
# .env kabhi commit nahi hoti (.gitignore mein hai). Ye .env.example commit hoti
# hai taake naye contributor ko pata chale ke kaunse variables chahiyen -
# bina koi secret leak kiye.

# Neon Postgres connection string.
# Neon dashboard -> Project -> Connection string se milti hai.
#
# Dhyan dein: Neon "sslmode=require" deta hai, lekin humne "verify-full" kiya hai.
# Wajah: pg abhi to "require" ko "verify-full" ki tarah hi treat karta hai, magar
# pg v9 se woh libpq wale matlab par chala jayega - jahan "require" ka matlab hai
# "encrypt karo lekin certificate check mat karo" (yaani man-in-the-middle mumkin).
# Explicitly verify-full likh dene se ye behaviour kabhi khud-ba-khud kamzor nahi hoga.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=verify-full&channel_binding=require

# Server kis port par chale (optional, default 4375)
PORT=4375
